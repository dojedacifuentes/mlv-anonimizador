diff --git a/src/anonymizer/anonymize/plugins.py b/src/anonymizer/anonymize/plugins.py
index b06ba2b..ddab055 100644
--- a/src/anonymizer/anonymize/plugins.py
+++ b/src/anonymizer/anonymize/plugins.py
@@ -235,3 +235,37 @@ def load_recognizer_plugins(
             logger.warning("Failed to load recognizer plugin: %s", exc)
 
     return out
+
+
+def load_postfilters(
+    entries: list[Any] | None,
+    *,
+    base_dir: Path | None = None,
+) -> tuple[list[Any], list[str]]:
+    """Load config ``postfilters:`` entries ({python: file.py, function: name}).
+
+    Each function receives (text, results) and returns the results to keep.
+    """
+    loaded: list[Any] = []
+    errors: list[str] = []
+    for i, raw in enumerate(entries or []):
+        try:
+            if not isinstance(raw, dict) or "python" not in raw or "function" not in raw:
+                raise ValueError("need python: path and function: name")
+            py_path = _resolve_path(str(raw["python"]), base_dir=base_dir)
+            if not py_path.is_file():
+                raise ValueError(f"Python postfilter not found: {py_path}")
+            spec = importlib.util.spec_from_file_location(
+                f"anonymizer_plugin_{py_path.stem}", py_path
+            )
+            if spec is None or spec.loader is None:
+                raise ValueError(f"Cannot load Python postfilter from {py_path}")
+            mod = importlib.util.module_from_spec(spec)
+            spec.loader.exec_module(mod)
+            fn = getattr(mod, str(raw["function"]), None)
+            if not callable(fn):
+                raise ValueError(f"function {raw['function']!r} not found in {py_path}")
+            loaded.append(fn)
+        except Exception as exc:  # noqa: BLE001 — collect for config load
+            errors.append(f"postfilters[{i}]: {exc}")
+    return loaded, errors
